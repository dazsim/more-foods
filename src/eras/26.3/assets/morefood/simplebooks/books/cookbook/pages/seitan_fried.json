  "ingredients": [
    "minecraft:wheat",
    "minecraft:water_bucket"
  ],
  "tools": [
    "minecraft:crafting_table",
    "morefood:item_pestle_mortar",
    "morefood:item_mixing_bowl",
    "morefood:item_pot",
    "morefood:item_frying_pan",
    "morefood:block_stove",
    "morefood:block_kitchen_sink"
  ],
  "need_note": "Tools and Buckets are not consumed",
  "steps": [
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_pestle_mortar",
        "minecraft:wheat"
      ],
      "output": "morefood:item_flour"
    },
    {
      "kind": "process",
      "title": "Salt",
      "note": "20 seconds,\nor over a\ncampfire, slower",
      "inputs": [
        "minecraft:water_bucket"
      ],
      "appliance": "morefood:item_pot",
      "on": "morefood:block_stove",
      "output": {
        "item": "morefood:item_salt",
        "count": 2
      }
    },
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_mixing_bowl",
        "morefood:item_flour",
        "morefood:item_salt",
        "minecraft:water_bucket"
      ],
      "output": "morefood:item_dough"
    },
    {
      "kind": "process",
      "title": "Seitan",
      "note": "use it on the\nsink or hopper\nit in",
      "inputs": [
        "morefood:item_dough"
      ],
      "appliance": "morefood:block_kitchen_sink",
      "output": "morefood:item_seitan"
    },
    {
      "kind": "process",
      "title": "Fried Seitan",
      "note": "5 seconds,\nfrom the stove\noutput",
      "inputs": [
        "morefood:item_seitan"
      ],
      "appliance": "morefood:item_frying_pan",
      "on": "morefood:block_stove",
      "output": "morefood:item_seitan_fried"
    }
  ]
